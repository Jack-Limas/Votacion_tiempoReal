# Copy to .env on the VM (never commit .env) and fill every value.
# Generate secrets with: openssl rand -hex 32

# Public address served by Caddy with automatic HTTPS. With sslip.io no DNS
# setup is needed: <PUBLIC_IP>.sslip.io resolves to <PUBLIC_IP>.
SITE_ADDRESS=20.30.40.50.sslip.io

# Valkey is only reachable inside the Docker network; it still requires a password.
VALKEY_PASSWORD=change-me-openssl-rand-hex-32

# Verification desk: shared by the 8 replicas (at least 32 characters).
VERIFICATION_TOKEN_SECRET=change-me-openssl-rand-hex-32
VERIFICATION_AUDITOR_CODE=change-me-auditor-code
VERIFICATION_COORDINATOR_CODE=change-me-coordinator-code

# Comma-separated origins allowed by CORS for the HTTP API.
CORS_ORIGIN=https://20.30.40.50.sslip.io

# Optional tuning (defaults shown).
# MAXLEN=10000
# FLUSH_MS=1000
# BATCH_SIZE=100
# HEARTBEAT_MS=10000
# SLOW_SOFT_BYTES=262144
# SLOW_HARD_BYTES=1048576
# SLOW_MAX_DEGRADED_MS=30000
# RATE_LIMIT_PUBLIC_CONNECTS=60
# RATE_LIMIT_ACTAS=30
