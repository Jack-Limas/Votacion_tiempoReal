# Local development without Docker (npm start). With docker compose these
# values come from docker-compose.yml; production uses .env.production.example.

# --- HTTP server ---
PORT=3000
HOST=0.0.0.0
LISTEN_BACKLOG=4096
# Reverse proxies in front of the app (0 = none, 1 = nginx, 2 = Caddy + nginx).
TRUST_PROXY=0
CORS_ORIGIN=*
WS_PATH=/ws
INSTANCE_ID=

# --- Redis / Valkey ---
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=electoral:{results}
REDIS_IDEMPOTENCY_TTL_SECONDS=2592000

# --- Public results (RF-4, RF-5, RF-6, RF-9) ---
MAXLEN=10000
STREAM_BLOCK_MS=5000
STREAM_READ_COUNT=200
MAX_TOPICS=10
FANOUT_MODE=batched
FLUSH_MS=1000
BATCH_SIZE=100
HEARTBEAT_MS=10000
EL_RESOLUTION_MS=10
METRICS_TTL_S=5
MAX_REPLAY=500
SLOW_SOFT_BYTES=262144
SLOW_HARD_BYTES=1048576
SLOW_MAX_DEGRADED_MS=30000
POLL_CACHE_MS=1000

# --- Verification desk (RF-7, RF-8). All instances must share the secret. ---
# Generate one with: openssl rand -hex 32
VERIFICATION_TOKEN_SECRET=change-me-to-a-random-string-of-at-least-32-chars
VERIFICATION_TOKEN_TTL_SECONDS=43200
VERIFICATION_AUDITOR_CODE=change-me-auditor
VERIFICATION_COORDINATOR_CODE=change-me-coordinator
VERIFICATION_KEY_PREFIX=electoral:{verification}
VERIFICATION_LEASE_TTL_MS=15000
VERIFICATION_IDLE_LIMIT_MS=300000
VERIFICATION_HEARTBEAT_MS=5000
VERIFICATION_PRESENCE_TTL_MS=30000
VERIFICATION_SWEEP_INTERVAL_MS=2000

# --- Rate limits (fixed window per credential) ---
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_HTTP_REQUESTS=20
RATE_LIMIT_WS_MESSAGES=40
RATE_LIMIT_ACTAS=30
# New public connections per IP and window (0 disables it).
RATE_LIMIT_PUBLIC_CONNECTS=60
